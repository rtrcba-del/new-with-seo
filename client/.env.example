# Copy to .env.local (or set in your host's environment variables) before building.

# Cloudflare Turnstile PUBLIC site key (Cloudflare dashboard -> Turnstile).
# Leave empty to build without the widget. The SECRET key does not go here:
# paste it into Formspree (form settings -> CAPTCHA -> Cloudflare Turnstile).
VITE_TURNSTILE_SITE_KEY=

# Optional: URL of the Express API when the client is deployed separately.
# VITE_API_URL=
